## systemd service: keeps the bot running 24/7, restarts it on crashes and
## hangs, and survives reboots. Installed by deploy/install.sh — you never
## need to edit this file (all settings, including live-mode confirmation,
## live in /opt/binance-bot/.env).

[Unit]
Description=Binance futures trading engine
After=network-online.target
Wants=network-online.target

[Service]
# notify + WatchdogSec: the bot heartbeats every cycle; if the process HANGS
# (not just crashes) for 5 minutes, systemd kills and restarts it.
Type=notify
WatchdogSec=300
NotifyAccess=all
# startup loads exchange markets twice; testnet can be slow
TimeoutStartSec=300
WorkingDirectory=/opt/binance-bot
ExecStart=/usr/bin/python3 /opt/binance-bot/main.py
# on-failure (NOT always): the kill switch exits cleanly and must STAY
# stopped; crashes exit non-zero and restart automatically.
Restart=on-failure
RestartSec=15
# 78 = refused to start live without BOT_CONFIRM_LIVE=yes: don't loop
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target
